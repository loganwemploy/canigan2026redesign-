# Random string used to encrypt Payload sessions/tokens
PAYLOAD_SECRET=change-me
# SQLite file for local dev. Swap for a hosted DB (e.g. Postgres) in production.
DATABASE_URI=file:./canigan.db
# For Neon or another hosted Postgres database, use its pooled URL here instead.
# DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require
# Public URL of the site (used by Payload Live Preview)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional: create the first admin user when running `npm run seed`
SEED_ADMIN_EMAIL=candy@caniganhealthoptions.com
SEED_ADMIN_PASSWORD=change-me-strong
